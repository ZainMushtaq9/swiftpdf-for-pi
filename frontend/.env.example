# Frontend env vars (Vite). Copy to .env for local dev.
# Backend API base. Empty = same origin (Vite proxies /api to the
# FastAPI backend on :8000 in dev). In production, set the deployed
# backend URL, e.g. https://pi-pdf-api.onrender.com
VITE_API_URL=

# Pi network: "true" = Testnet/Sandbox (default, always for local dev),
# "false" = Mainnet/Production (only for the production build, with a
# Production app registered in the Developer Web Console).
VITE_PI_SANDBOX=true

# Dev-only mock of window.Pi: "true" simulates sign-in and payments
# locally (use with the backend's PI_MOCK_MODE=true). NEVER "true" in a
# production build.
VITE_PI_MOCK=false
