# SwiftPDF for Pi backend (Pi Next 2026) — copy to .env and fill in real values.
# Never commit a real .env with secrets.

# Pi Server API Key (from the Pi Developer Portal). Required for payments.
PI_API_KEY=CHANGE_ME
# Pi App ID (from the Pi Developer Portal).
PI_APP_ID=CHANGE_ME
# Pi network: "staging" (Testnet) for development, "production" for Mainnet.
PI_NETWORK=staging
# Pi Platform API base URL.
PI_PLATFORM_API_BASE=https://api.minepi.com/v2
# SQLite database path (relative to backend/, or absolute).
DATABASE_PATH=data/app.db
# Price of the Pro unlock, in Pi.
PRO_PRICE_PI=1.0
# Memo shown on the Pi payment.
PRO_MEMO=Pro unlock — SwiftPDF for Pi
# Session lifetime in days.
SESSION_DAYS=30
# Comma-separated origins allowed to call this API (the frontend).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# WARNING: mock mode returns CANNED Pi responses (any token verifies, any
# payment completes) and performs no real HTTP. LOCAL TESTING ONLY.
# NEVER enable in production — it would grant Pro without real payment.
PI_MOCK_MODE=false
